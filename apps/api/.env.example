DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exam_platform"
JWT_SECRET="change-me-in-production"
# REQUIRED. Base64 of 32 random bytes; encrypts the exam access code with AES-256-GCM.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do NOT use PowerShell's [System.Security.Cryptography.RandomNumberGenerator] for this on
# Windows PowerShell 5.1: it can silently produce 32 zero bytes there.
# There is no default on purpose. The key is only read when an access code is actually
# encrypted, so leaving it empty lets the server boot, pass /health and pass the test suite,
# and then fail at the moment an admin approves an exam. Fail loudly instead.
ACCESS_CODE_ENC_KEY=""
PORT=4000
CORS_ORIGIN="http://localhost:5173"
# List of accepted Safe Exam Browser keys (comma-separated)
SEB_KEYS=""
# Lab-network CIDR allowlist (comma-separated, e.g. 10.20.0.0/16). Empty = disabled (dev).
LAB_IP_RANGES=""